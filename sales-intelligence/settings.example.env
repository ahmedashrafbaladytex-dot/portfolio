# ========= إعدادات بوت ذكاء المبيعات =========
# مش لازم تفتح الملف ده: البوت بيسألك على التوكن أول مرة، وبيحفظ الجروب لما تبعت كود الربط.
# الملف ده للإعدادات المتقدمة بس (اتنسخ تلقائي باسم settings.env)

# 1) توكن البوت من @BotFather على تليجرام (إلزامي)
TELEGRAM_BOT_TOKEN=

# 2) الجروبات المربوطة (بتتملي لوحدها لما تبعت كود الربط في الجروب)
ALLOWED_CHATS=

# الجروب اللي التقارير التلقائية بتتبعت عليه (لو فاضي = أول جروب)
REPORT_CHAT=

# 3) مفتاح Claude (اختياري بس بيفرق جداً): قراءة صور وPDF الفواتير، والتحليل الاستراتيجي، والأسئلة الحرة
#    من https://console.anthropic.com
ANTHROPIC_API_KEY=

# ميعاد التقرير اليومي (بتوقيت القاهرة)
DAILY_REPORT_TIME=21:00
# يوم التقرير الأسبوعي الكامل: 0 الأحد، 1 الاتنين، 2 التلات، 3 الأربع، 4 الخميس، 5 الجمعة، 6 السبت
WEEKLY_REPORT_DAY=0
# ميعاد التقرير الأسبوعي (بتوقيت القاهرة)
WEEKLY_REPORT_TIME=09:00

# التحليل
ANALYSIS_DAYS=90
# مدة الإنتاج بالأيام (من أمر التشغيل لحد ما البضاعة تبقى جاهزة)
LEAD_TIME_DAYS=14
# عايز المخزون يغطي كام يوم بعد ما الإنتاج يخلص
COVER_DAYS=30
# نسبة المرتجع اللي فوقها الصنف يتعلّم «مشكلة» (0.10 = 10%)
RETURN_ALERT=0.10

# الربط مع نظام طلبات العملاء (orders-system). الافتراضي بيدور عليه جنب الفولدر ده تلقائياً.
# اكتب off لإلغاء الربط، أو مسار ملف orders.db لو في مكان تاني
ORDERS_DB=
